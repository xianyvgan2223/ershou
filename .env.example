# =============================================================
# .env 模板：复制为 .env 后填入真实密码（.env 不提交到 Git）
#   copy .env.example .env
# =============================================================

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ershou
MYSQL_USER=ershou
MYSQL_PASSWORD=change_me
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=change_me
MYSQL_CONTAINER_PORT=3307

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change_me
REDIS_DATABASE=0

MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=ershou
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=ershou
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9010/ershou
# ---------- 微服务配置占位符（ershou-cloud/nacos-configs/*.yaml 的 ${...}）----------
# Spring 启动时从环境变量解析；scripts/start-full-cloud.ps1 会自动载入 .env。
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change_me
# Seata 客户端连 Nacos 的账号（当前 Nacos 未开鉴权，留默认值即可）
NACOS_AUTH_USERNAME=nacos
NACOS_AUTH_PASSWORD=nacos
# Seata Server（docker compose 用 --env-file 注入 application.yml 的 ${...}）
SEATA_CONSOLE_USERNAME=seata
SEATA_CONSOLE_PASSWORD=change_me
SEATA_NACOS_USERNAME=nacos
SEATA_NACOS_PASSWORD=change_me
SEATA_SECRET_KEY=change_me
# 以下两个加密 key 必须与历史数据一致，改了会导致旧数据解不开
# PHONE_CRYPTO_KEY 给微服务（user-service），PHONE_AES_KEY 给旧单体，两者必须是同一个值
PHONE_CRYPTO_KEY=change_me
PHONE_AES_KEY=change_me
CHAT_CONTENT_KEY=change_me

# ---------- Elasticsearch（商品搜索；单节点无认证，仅本机开发）----------
ES_PORT=9211
# ⚠️ 不要用 9210：[::]:9210 被 WSL 的 wsl-bootstrap 占用、127.0.0.1:9210 被 QQ 占用，
# 访问它会拿到别的服务的响应（真实 ES 根本连不上），表现为 reindex 一直 90001。
ES_URIS=http://127.0.0.1:9211

# ---------- 高德地图（Web端 JS API）----------
# 前端经 vite envDir 读取（见 ershou-web/vite.config.ts），只有 VITE_ 前缀会注入浏览器
# 控制台：https://console.amap.com/dev/key 服务平台必须选「Web端(JS API)」，并同时复制安全密钥
VITE_AMAP_JS_KEY=change_me
VITE_AMAP_JS_SECURITY_CODE=change_me

# ---------- 商品有效期 / 限时下架（第 4 轮新增；开发期便于测试/演示）----------
# 商品限时总开关：
#   true  = 发布/重新上架写 expire_at = now + ITEM_VALID_DAYS，到期任务每小时自动下架（生产默认）
#   false = 发布/重新上架不写 expire_at（NULL，永久有效），到期任务整体跳过（开发/演示期推荐）
ITEM_VALIDITY_ENABLED=true
# 商品有效期（天）：仅 ITEM_VALIDITY_ENABLED=true 时生效
ITEM_VALID_DAYS=7

